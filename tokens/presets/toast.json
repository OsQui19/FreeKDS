{
  "$schema": "https://beta.openui.org/schemas/design-tokens.json",
  "meta": {
    "name": { "value": "Toast-like" },
    "description": { "value": "Rounded corners, warm accent" }
  },
  "color": {
    "accent": { "type": "color", "value": "#ff6a00", "description": "Primary accent color" },
    "surface": { "type": "color", "value": "#ffffff", "description": "Card and panel background" },
    "background": { "type": "color", "value": "#f7f7f7", "description": "App background" },
    "text": { "type": "color", "value": "#1f2937", "description": "Default text color" }
  },
  "radius": {
    "card": { "type": "dimension", "value": "0.5rem", "description": "Corner radius for cards" },
    "button": { "type": "dimension", "value": "0.375rem", "description": "Corner radius for buttons" },
    "field": { "type": "dimension", "value": "0.375rem", "description": "Corner radius for inputs" }
  },
  "font": {
    "size": {
      "sm": { "type": "fontSize", "value": ".9rem", "description": "Small body text" },
      "md": { "type": "fontSize", "value": "1rem", "description": "Default body text" },
      "lg": { "type": "fontSize", "value": "1.15rem", "description": "Large body text" }
    }
  },
  "shadow": {
    "sm": { "type": "shadow", "value": "0 1px 2px rgba(0,0,0,.08)", "description": "Subtle small shadow" },
    "md": { "type": "shadow", "value": "0 6px 12px rgba(0,0,0,.12)", "description": "Medium depth shadow" }
  }
}
