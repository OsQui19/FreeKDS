    "surface": { "type": "color", "value": "#ffffff" },
    "background": { "type": "color", "value": "#f5f5f5" },
    "text": { "type": "color", "value": "#111827" }
  },
  "radius": {
    "card": { "type": "dimension", "value": "0.25rem" },
    "button": { "type": "dimension", "value": "0.25rem" },
