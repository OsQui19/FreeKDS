{
  "$schema": "https://beta.openui.org/schemas/design-tokens.json",
  "meta": {
    "name": { "value": "Square-like" },
    "description": { "value": "Crisp corners, neutral palette" }
  },
  "color": {
    "accent": { "type": "color", "value": "#2d2e2f", "description": "Primary accent color" },
    "surface": { "type": "color", "value": "#ffffff", "description": "Card and panel background" },
    "background": { "type": "color", "value": "#f5f5f5", "description": "App background" },
    "text": { "type": "color", "value": "#111827", "description": "Default text color" }
  },
  "radius": {
    "card": { "type": "dimension", "value": "0.25rem", "description": "Corner radius for cards" },
    "button": { "type": "dimension", "value": "0.25rem", "description": "Corner radius for buttons" },
    "field": { "type": "dimension", "value": "0.25rem", "description": "Corner radius for inputs" }
  },
  "font": {
    "size": {
      "sm": { "type": "fontSize", "value": ".9rem", "description": "Small body text" },
      "md": { "type": "fontSize", "value": "1rem", "description": "Default body text" },
      "lg": { "type": "fontSize", "value": "1.1rem", "description": "Large body text" }
    }
  },
  "shadow": {
    "sm": { "type": "shadow", "value": "0 1px 2px rgba(0,0,0,.06)", "description": "Subtle small shadow" },
    "md": { "type": "shadow", "value": "0 4px 8px rgba(0,0,0,.1)", "description": "Medium depth shadow" }
  }
}
